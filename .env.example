# 환경변수 예시 — 변수 이름과 설명만 적는다. 실제 키 값은 .env 에 넣고(.env 는 Git에 올리지 않는다), 이 파일에는 절대 적지 않는다.
#
# 이번 단계(목업 화면)에서는 아무것도 사용하지 않는다.
# 실제 API를 연결할 때 "서버"의 환경변수로 읽는다. 브라우저 코드에는 REST API 키와 서비스 키를 넣지 않는다.

# 인천국제공항공사_여객기 운항 현황 상세 조회 서비스 (공공데이터포털 서비스 키, 서버 전용)
ICN_AIRPORT_API_KEY=

# 카카오 로컬 API(주소 검색) · 카카오모빌리티 자동차 길찾기 API용 REST API 키 (서버 전용)
KAKAO_REST_API_KEY=

# 카카오 JavaScript SDK 키 (지도 화면을 만드는 후속 단계에서만 사용. 카카오 개발자 콘솔에서 웹 도메인 제한 확인)
KAKAO_JAVASCRIPT_KEY=
